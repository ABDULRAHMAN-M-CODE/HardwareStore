


@model User // model is input to the view, comes from the Action method 'EditUser'.

@{
    ViewData["Title"] = "Edit user";
}

<body class="bg-primary-subtle">
    <div class="col-md-4 mx-auto mt-5 ">
        <form id="registerForm" asp-controller="Account" asp-action="EditConfirmed" method="post" > 
            <h1>@ViewData["Title"]</h1>
            <hr />
            @Html.HiddenFor(model => model.Id) @*I could  instead use the asp-route-Id="@model.Id", both works, but I think there is security difference.  *@
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" aria-required="true" placeholder="Qutiba" type="text" />
                <label asp-for="Name"></label>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="EmailOrPhoneNumber" class="form-control" aria-required="true" placeholder="name@example.com" type="text" />
                <label asp-for="EmailOrPhoneNumber">Email or phone number</label>
                <span asp-validation-for="EmailOrPhoneNumber" class="text-danger"></span>
            </div>

            <button id="editSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Confirm</button>
        </form>
    </div>
</body>

@*The following is necessary for Client-side validation, it's for better user experience, it's not security, I should always implement server-side validation because user can simply disable javascript in his browser*@
@* Client-side validation prevents submission until the form is valid. The Submit button runs JavaScript that either submits the form or displays error messages.,*@
@*Client-side validation avoids an unnecessary round trip to the server when there are input errors on a form*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
