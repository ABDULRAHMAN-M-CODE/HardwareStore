
@*
    I was fucking able to use the following even though I did not define it in the code.
    User.Identity?.IsAuthenticated

*@

@{
    ViewData["Title"]= "Logout";
}

<header>
    <h1>@ViewData["Title"]</h1>
    @{
        @* if statement was executed when the code detected that the user is logged in*@
        if (User.Identity?.IsAuthenticated ?? false)
        {
            Console.WriteLine("If block executed");
            <form class="form-inline" asp-controller="Account" asp-action="LogoutConfirmed"  method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Click here to Logout</button>
            </form>
        }
        @* else statement was executed when the code detected that the user is  NOT logged in*@
        else
        {
            <p>You are logged out OR You have successfully logged out of the application now.</p>
        }
    }
</header>

