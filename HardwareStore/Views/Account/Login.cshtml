
@model LoginViewModel

@{
    ViewData["Title"] = "Log in";
}


@*
    Note : I want to copy the server-side validation rules to the client.

    How TO DOT THAT : asp-for, which is a tag helper, will use the the model's attributes to generate data- attributes for the form elements that need validation
    
    After that, the jQuery Unobtrusive Validation parses the data- attributes and passes the logic to jQuery Validation,ffectively "copying" the server-side validation logic to the client.

*@
<body class="bg-primary-subtle">
    <div class="col-md-4 mx-auto mt-5">
        <section>
            <form id="account" method="post" asp-controller="Account" asp-action="ProcessLoginRequest">
                <h1>@ViewData["Title"]</h1>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="EmailOrPhoneNumber" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="EmailOrPhoneNumber" class="form-label">Email or Phone number</label>
                    <span asp-validation-for="EmailOrPhoneNumber" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Password" class="form-label">Password</label>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="checkbox mb-3">
                    <label asp-for="RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="RememberMe" />
                        @Html.DisplayNameFor(m => m.RememberMe)
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
                </div>
            </form>
        </section>
    </div>

</body>
@*Client-side validation will not work without the following*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
