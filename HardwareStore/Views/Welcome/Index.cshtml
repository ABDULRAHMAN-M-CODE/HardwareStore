@{
    ViewData["Title"]="Home Page";
}




<body class="bg-primary-subtle">

<div id="home-div" class=" d-flex flex-column justify-content-center align-items-center " >

    <h1>Welcome</h1>
    <div>

            <a class="btn btn-primary " role="button" asp-controller="Account" asp-action="Login">
                Login
            </a>
            
            <a class="btn btn-primary bg-white text-black" role="button" asp-controller="Account" asp-action="Register">
               Signup
            </a>
            
    </div>

</div>
</body>


@section Styles{
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}