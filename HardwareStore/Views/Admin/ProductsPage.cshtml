
@{
    ViewData["Title"] = "Products page";
}
<h1>Products Page</h1>
<label for="avatar">Choose a file:</label>

<input class="form-control form-control-lg" id="formFileLg" type="file" accept=".xlsx" />
<div class="container" id="cancelContainer">

</div>


<script>
    console.log("Script Executed")
    document.getElementById("formFileLg").addEventListener("change", importFile);

    
    
    async function importFile() {
        console.log("importFil executed")
        const controller = new AbortController();

        let cancelContainer = document.getElementById("cancelContainer");
        let cancelButton = document.createElement('BUTTON');
        cancelButton.appendChild(document.createTextNode("Cancel"));
        cancelButton.onclick = function() {
            console.log("abort executed")
            controller.abort()
            cancelButton.remove();
        }
        
        cancelContainer.appendChild(cancelButton);


        const formData = new FormData();
        formData.append("file", this.files[0]);

        try {
            console.log("Try block executed.")
            response = await fetch('/Admin/Import', { 
                method: 'POST',
                body: formData,
                signal:controller.signal
               
            })
            if (!response.ok) {
                console.log("response is not ok")
                throw new Error(`Response status: ${response.status}`);
                window.location.href = "/Admin/ImportError";
                return;
            }

            alert("success");
            // staty in ProductsPage to inspect performance metrics.

            // logic : after admin upload the excel file, he will not be redirected to new view, he should stay in this same view, the only difference is that the admin will be able to see the data he uploaded in the UI.
            
           
           
           //window.location.href = "/Admin/ImportResult"; // return RedirectToAction in the action method won't fucking work. because it must return control to the caller, which is the fetch-api

        }

        catch (error) {

            if (error.name == "AbortError") {
                console.log("catch block executed: AbortError")
            }
            
            console.error(error.message);
        }
        cancelButton.remove();
    }



</script>