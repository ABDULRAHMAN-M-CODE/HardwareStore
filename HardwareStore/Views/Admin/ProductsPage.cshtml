@{
    ViewData["Title"] = "Products page";
}

    <h1>Products Page</h1>
    <label for="avatar">Choose a file:</label>

    <input class="form-control form-control-lg" id="formFileLg" type="file" accept=".xlsx" />
    <div class="container" id="cancelContainer">
    </div>

    <div class="d-grid gap-3" id="productsContainer"></div>
    <dialog id="dialog">
        <p>Products were imported into the database.</p>
        <button type="button" id="close">Close</button>
    </dialog>

<script src="~/js/app.js"></script>
